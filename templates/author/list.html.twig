<!DOCTYPE html>
<html>
<head>
    <title>Liste des auteurs</title>
</head>
<body>
    <h1>Liste des auteurs</h1>

    {% if authors is not defined or authors is empty %}
        <p>Aucun auteur trouvé.</p>
    {% else %}
        <p>Nombre d’auteurs : {{ authors|length }}</p>
        <p>Total de livres : {{ authors|map(a => a.nb_books)|reduce((carry, v) => carry + v) }}</p>

        <ul>
            {% for author in authors %}
                <li>
                    <img src="{{ author.picture }}" alt="{{ author.username }}" width="100">
                    <strong>{{ author.username|upper }}</strong> <br>
                    Email : {{ author.email }} <br>
                    Livres publiés : {{ author.nb_books }} <br>
                    <a href="{{ path('app_author_details', {'id': author.id}) }}">Détails</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</body>
</html>
