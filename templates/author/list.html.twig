<!DOCTYPE html>
<html>
<head>
    <title>Liste des auteurs</title>
</head>
<body>
    <h1>Liste des auteurs</h1>

    {% if authors is not defined or authors is empty %}
        <p>Aucun auteur trouvé.</p>
    {% else %}
            <p>Nombre d’auteurs : {{ authors|length }}</p>
            <p>Total de livres : {{ authors|map(a => a.nb_books)|reduce((carry, v) => carry + v) }}</p>

            <table border="1" cellpadding="8" cellspacing="0">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Livres publiés</th>
                        <th>Détails</th>
                    </tr>
                </thead>
                <tbody>
                    {% for author in authors %}
                    <tr>
                        <td><img src="{{ author.picture }}" alt="{{ author.username }}" width="100"></td>
                        <td><strong>{{ author.username|upper }}</strong></td>
                        <td>{{ author.email }}</td>
                        <td>{{ author.nb_books }}</td>
                        <td><a href="{{ path('app_author_details', {'id': author.id}) }}">Détails</a></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
    {% endif %}
</body>
</html>
